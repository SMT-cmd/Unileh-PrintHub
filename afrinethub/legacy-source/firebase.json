      { "source": "/portal", "destination": "/portal/index.html" },
      { "source": "/news", "destination": "/news/index.html" },
      { "source": "/partners", "destination": "/partners/index.html" },
      { "source": "/about", "destination": "/about/index.html" },
      { "source": "/privacy", "destination": "/privacy/index.html" },
      { "source": "/terms", "destination": "/terms/index.html" },
      { "source": "/refund", "destination": "/refund/index.html" },
      { "source": "/admin", "destination": "/admin/index.html" },
      { "source": "/admin/dashboard", "destination": "/admin/dashboard/index.html" }
