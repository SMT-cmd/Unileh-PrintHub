# Public Firebase browser config for the existing UNILESH project.
# Copy to .env.local and fill these from existing assets/js/database.js.
# Never put Firebase Admin credentials or Supabase service-role keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
